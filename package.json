{
  "name": "project-rota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm check && vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run && node --test storage/server.test.mjs",
    "gen": "bash scripts/gen.sh",
    "check": "pnpm typecheck && pnpm test",
    "data:dev": "node --env-file=.env storage/server.mjs",
    "test:browser": "playwright test",
    "test:agent-browser": "playwright test --config test/browser/agent.config.ts"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@ai-sdk/anthropic": "^3.0.137",
    "@ai-sdk/google": "^3.0.140",
    "@ai-sdk/openai": "^3.0.135",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@file-viewer/doc": "3.3.3",
    "@file-viewer/ppt": "1.0.2",
    "ai": "^6.0.320",
    "hono": "^4.6.14",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "oauth4webapi": "^3.8.8",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jose": "^6.2.15",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  }
